# Server
PORT=3000
NODE_ENV=development

# Google Gemini AI (REQUIRED)
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Admin SDK (REQUIRED - every /api/* route verifies a Firebase ID token)
# FIREBASE_PROJECT_ID must exactly match the project id embedded in
# FIREBASE_CLIENT_EMAIL (firebase-adminsdk-xxxx@<projectId>.iam.gserviceaccount.com),
# otherwise Firestore calls fail with PERMISSION_DENIED / CONSUMER_INVALID.
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key_here\n-----END PRIVATE KEY-----"
FIREBASE_CLIENT_EMAIL=your_service_account_email@your-project-id.iam.gserviceaccount.com

# File upload limits
MAX_FILE_SIZE=50mb
MAX_FILES=10
